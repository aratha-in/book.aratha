# ===================================================
# ARATHA PUBLICATION ENVIRONMENT CONFIGURATION
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:5000

# Neon PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_secret@ep-cool-forest-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication & Session Security
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security_aratha_pub
JWT_EXPIRES_IN=7d
ADMIN_INITIAL_EMAIL=admin@aratha.com
ADMIN_INITIAL_PASSWORD=ArathaAdmin2026!

# Object & File Storage Configuration
# Options: local | cloudinary | s3
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
# If using Cloudinary:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Delivery Configuration (e.g., Resend, Sendgrid, or SMTP)
EMAIL_PROVIDER=console
# If using Resend:
RESEND_API_KEY=re_123456789
EMAIL_FROM="Aratha Publication <publishing@aratha.com>"
CONTACT_RECEIVER_EMAIL="submissions@aratha.com"

# Security & CORS
CORS_ORIGIN=http://localhost:5173
